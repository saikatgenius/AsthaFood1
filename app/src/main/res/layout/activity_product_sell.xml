<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/theme_color"
    tools:context=".activity.ProductSellActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
        <include layout="@layout/custom_toolbar" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_10mdp"
            android:layout_height="50dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="4dp"
                android:layout_weight=".4"
                android:gravity="center"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/txtSearchShopkeeper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/background_white"
                    android:elevation="8dp"
                    android:hint="Search MobileNo or Name..."
                    android:maxLines="1"
                    android:padding="9.5dp"
                    android:textColor="@color/textLoanRenewal"
                    android:textColorHint="@color/hintLoanRenewal"
                    android:textSize="14dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="5dp"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">


                <Button
                    android:id="@+id/btnSearchShopkepper"
                    android:layout_width="100dp"
                    android:layout_height="42dp"
                    android:background="@drawable/button_background_buttons"
                    android:elevation="6dp"
                    android:text="Search"
                    android:textColor="#fff" />
            </LinearLayout>
        </LinearLayout>
        <Spinner
            android:visibility="gone"
            android:id="@+id/sp_activity_get_shopkeeper_list"
            android:layout_width="match_parent"
            android:layout_marginHorizontal="@dimen/_5mdp"
            android:layout_height="50dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/_10mdp"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/shopkeeper_name"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/_10mdp"
                android:hint="Enter ShopKeeper Name"
                android:textSize="14sp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/colorBlack"
                android:background="@drawable/border_background"
                android:layout_height="@dimen/_40mdp">
            </EditText>
            <EditText
                android:id="@+id/shopkeeper_phone"
                android:layout_width="match_parent"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:hint="Enter ShopKeeper Phone"
                android:textSize="14sp"
                android:inputType="phone"
                android:maxLength="10"
                android:layout_marginHorizontal="@dimen/_10mdp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:textColor="@color/colorBlack"
                android:background="@drawable/border_background"
                android:layout_height="@dimen/_40mdp">

            </EditText>


        </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_10mdp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/shopkeeper_address"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_10mdp"
            android:hint="Enter ShopKeeper Address"
            android:textSize="14sp"
            android:layout_weight="1"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/colorBlack"
            android:background="@drawable/border_background"
            android:layout_height="@dimen/_40mdp">
        </EditText>
        <EditText
            android:id="@+id/shop_name"
            android:layout_width="match_parent"
            android:layout_gravity="center"
            android:layout_marginHorizontal="@dimen/_10mdp"
            android:hint="Enter Shop Name"
            android:textSize="14sp"
            android:layout_weight="1.2"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:textColor="@color/colorBlack"
            android:background="@drawable/border_background"
            android:layout_height="@dimen/_40mdp">
        </EditText>

    </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:gravity="center"
            android:layout_height="50dp">


            <TextView
                android:id="@+id/tv_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="ProductName"
                android:layout_weight="1.2"
                android:textColor="@color/black"
                android:textSize="10dp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/Code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight=".6"
                android:gravity="center"
                android:text="ProDuct\nCode"
                android:textColor="@color/colorBlack"
                android:textSize="10dp"
                android:textStyle="bold"
                />

            <TextView
                android:id="@+id/stock"
                android:layout_width="5dp"
                android:layout_weight="0.6"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Avl.\nQnty"
                android:textColor="@color/colorRed"
                android:textSize="10dp"
                />

            <TextView
                android:id="@+id/tv_price"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Price\n(GST Incl.)"
                android:textColor="@color/colorBlack"
                android:textSize="10dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Sell Qnty"
                android:textColor="@color/colorBlack"
                android:textSize="10dp" />




        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="#eaeaea" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvproductDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/textView2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clHeading" />

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginHorizontal="40dp"
        app:cardCornerRadius="@dimen/_20mdp"
        android:elevation="@dimen/_10mdp"
        android:layout_marginBottom="@dimen/_60font_mdp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_margin="@dimen/_8mdp"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Total Price :"
                        android:textSize="@dimen/_10font_mdp"
                        android:layout_weight="1.2"
                        android:gravity="center"

                        android:layout_gravity="center"/>
                    <TextView
                        android:id="@+id/price"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Total Price"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_12font_mdp"
                        android:layout_gravity="center"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Total GST :"
                        android:textSize="@dimen/_10font_mdp"
                        android:layout_weight="1.2"
                        android:gravity="center"

                        android:layout_gravity="center"/>
                    <TextView
                        android:id="@+id/gst"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Total Price"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_12font_mdp"
                        android:layout_gravity="center"
                        android:gravity="center" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="Grand Total :"
                        android:textSize="@dimen/_10font_mdp"
                        android:layout_weight="1.2"
                        android:gravity="center"

                        android:layout_gravity="center"/>
                    <TextView
                        android:id="@+id/grandTotal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:hint="Total Price"
                        android:layout_weight="1"
                        android:layout_marginEnd="@dimen/_12font_mdp"
                        android:layout_gravity="center"
                        android:gravity="center" />
                </LinearLayout>

            </LinearLayout>


            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/getTotal"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:layout_weight="1.5"
                android:background="@drawable/bottom_background"
                android:text="GET Amount"
                />

        </LinearLayout>




    </androidx.cardview.widget.CardView>

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/submit"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/_10mdp"
        android:background="@drawable/bottom_background"
        android:text="SELL PRODUCT"
        />

</RelativeLayout>