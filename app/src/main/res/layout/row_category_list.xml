<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/_7mdp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/_20mdp"
        app:cardCornerRadius="@dimen/_20mdp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:src="@drawable/category_bg"
                android:layout_width="match_parent"
                android:scaleType="fitXY"
                android:layout_height="@dimen/_130mdp"/>
            <TextView
                android:id="@+id/tv_category_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_20mdp"
                android:layout_centerInParent="true"
                android:layout_alignParentStart="true"
                android:text="dcvcwcwc"
                android:textSize="@dimen/_30font_mdp"
                android:textStyle="bold"
                android:textColor="@color/colorWhite"/>
        </RelativeLayout>

    </androidx.cardview.widget.CardView>



</LinearLayout>