<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"

    android:layout_marginVertical="@dimen/_5mdp"
    android:layout_marginHorizontal="@dimen/_3mdp"
    android:orientation="vertical"
    android:layout_height="wrap_content">
    <LinearLayout
        android:id="@+id/main_ll"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:gravity="center"
        android:background="@drawable/border_background"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tv_name12"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:hint="Pname"
            android:layout_weight="1.2"
            android:textColor="@color/darkGreen"
            android:textSize="10dp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/Code"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".6"
            android:gravity="center"
            android:hint="id"
            android:textColor="@color/colorBlack"
            android:textSize="10dp"
            android:textStyle="bold"
            />
        <TextView
            android:id="@+id/priceEmp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight=".6"
            android:gravity="center"
            android:hint="id"
            android:textColor="@color/colorBlack"
            android:textSize="10dp"
            android:textStyle="bold"
            />



        <EditText
            android:id="@+id/etSellingQnty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:inputType="number"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/red"
            android:singleLine="true"
            android:textSize="10sp"
            android:hint="Enter Qnty"/>
        <RelativeLayout
            android:id="@+id/add"
            android:layout_width="0dp"
            android:layout_margin="5dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/new_product_back">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:visibility="gone"
                    android:id="@+id/imageClick"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/baseline_check_24"/>
                <TextView
                    android:id="@+id/buttonText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/_5mdp"
                    android:text="Add To Queue"
                    android:textSize="10sp"
                    android:textColor="@color/white"
                    />
            </LinearLayout>



        </RelativeLayout>
    </LinearLayout>






</LinearLayout>
