<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical">
    <RelativeLayout
       android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:padding="8dp">


        <androidx.cardview.widget.CardView
            android:id="@+id/productCardView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"

            app:cardCornerRadius="12dp"
            android:backgroundTint="@color/theme_color"

            android:padding="@dimen/_10mdp"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:id="@+id/productLinearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:id="@+id/productImageView"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:layout_marginEnd="16dp"
                        android:scaleType="fitXY"
                        android:visibility="gone"
                        android:contentDescription="test product list "

                        android:src="@drawable/testimage"
                        tools:ignore="ContentDescription" />
                    <!-- Product Name -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:layout_height="match_parent">
                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="BILL ID:"
                            android:textColor="@android:color/white"
                            android:textSize="15sp"
                            tools:text="SELL ID:" />
                        <TextView
                            android:id="@+id/batchno"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_marginStart="@dimen/_8mdp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="0"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            tools:text="0" />
                        <TextView
                            android:id="@+id/productNameTextView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Product Name"
                            android:visibility="gone"
                            android:textColor="@android:color/primary_text_dark_nodisable"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="Sample Product" />



                        <TextView
                            android:id="@+id/productDetails"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="4dp"
                            android:visibility="gone"
                            android:text="Details: aegfszdfhzdfg set serfS AEreaw er"
                            android:textColor="@color/orange"
                            android:textSize="14sp"
                            tools:text="Details: sf sdbsbdnfgt dfgfgh hj fgh" />
                    </LinearLayout>

                </LinearLayout>


                <!-- Product Image -->


                <!-- Vertical LinearLayout for Text Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">



                    <!-- Sell Date -->
                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Sell Date: "
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Sell Date: " />
                    <TextView
                        android:id="@+id/sellDateTextView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_marginStart="@dimen/_4mdp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:textColor="@android:color/holo_blue_light"
                        android:textSize="14sp"
                        tools:text="0" />
                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Amount: ₹ "
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Amount: ₹ " />
                    <!-- Amount -->
                    <TextView
                        android:id="@+id/amountTextView"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="0"
                        android:layout_marginStart="@dimen/_4mdp"
                        android:textColor="@android:color/holo_green_light"
                        android:textSize="14sp"
                        tools:text="99.99" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">



                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Buyer: "
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Buyer: " />
                        <!-- Buyer Name -->
                        <TextView
                            android:id="@+id/buyerNameTextView"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Jonny"
                            android:layout_marginStart="@dimen/_8mdp"
                            android:textColor="@color/yellow"
                            android:textSize="14sp"
                            tools:text="  " />


                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Product NAME: "
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Product Name: " />

                        <TextView
                            android:id="@+id/productname"
                            android:layout_width="0dp"
                            android:layout_weight="1"

                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=" 12345"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text=" 12345" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Ph. :"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Ph. :" />
                        <!-- Buyer Name -->
                        <TextView
                            android:id="@+id/quantity"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=" "
                            android:layout_marginStart="@dimen/_8mdp"
                            android:textColor="@color/white"
                            android:textSize="14sp"
                            tools:text="  " />
                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Product ID: "

                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Product ID: " />
                        <TextView
                            android:id="@+id/productIdTextView"
                            android:layout_width="0dp"
                            android:layout_weight="1"

                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=" 12345"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text=" 12345" />

                        <!-- Bill Number -->


                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:orientation="horizontal">


                        <!-- Product ID -->
                        <TextView

                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Payment Amount: "
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text="Payment Amount: " />
                        <TextView
                            android:id="@+id/payment_amount"
                            android:layout_width="0dp"
                            android:visibility="gone"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text=" 12345"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            tools:text=" 12345" />




                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
        <ImageView
            android:id="@+id/warningIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_margin="20dp"
            android:src="@drawable/exclamation"
            android:visibility="gone"
            tools:ignore="ContentDescription"
            android:layout_alignTop="@id/productCardView"
            android:layout_alignEnd="@id/productCardView" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#eaeaea" />
</LinearLayout>