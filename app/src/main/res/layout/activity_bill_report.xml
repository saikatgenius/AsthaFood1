<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/theme_color"
    android:fitsSystemWindows="true"
    tools:context=".activity.SellBillActivity"
    android:orientation="vertical">

    <include layout="@layout/custom_toolbar" />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="wrap_content">



        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="2"
            android:layout_marginHorizontal="@dimen/_2mdp"
            android:layout_marginVertical="@dimen/_10mdp"
            android:background="@drawable/background_white">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="FDate"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_activity_agent_loan_due_report_fdate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:visibility="gone"
                android:textSize="13sp"
                android:textColor="@color/purple_200"
                android:hint="Select FDate"
              />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="DATE"
                android:textColor="@color/black"
               />

            <TextView
                android:id="@+id/tv_activity_agent_loan_due_report_tdate"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="16sp"
                android:hint="Select Date"
                android:layout_marginEnd="@dimen/_3mdp"
                android:textColor="@color/purple_200"
               />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
             android:visibility="gone"
            android:layout_marginEnd="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="@dimen/_3mdp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/ev_activity_agent_loan_due_report_enter_loan_code"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="2dp"
                android:layout_weight="1"
                android:background="@drawable/background_white"
                android:gravity="center"
                android:hint="Search by Loan code"
                android:textSize="12sp"
                android:visibility="gone"/>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_activity_agent_loan_due_report_show"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/login_button"
                android:text="Show"
                android:layout_margin="@dimen/_10mdp"
                android:textColor="@color/colorWhite"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pb_activity_agent_loan_due_report"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:indeterminateTint="@color/colorPrimary"
                android:visibility="gone"/>

        </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="2dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/btn_activity_agent_loan_due_report_show_all"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginEnd="20dp"
                android:layout_marginStart="20dp"
                android:background="@drawable/background_button_no_radius"
                android:text="SHOW ALL"
                android:textColor="#ffffff"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_activity_loan_due_report"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"/>


        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="@dimen/_40mdp">
            <TextView

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_weight="1"
                android:layout_gravity="center"
                android:text="Total Amount :"
                android:textColor="@android:color/holo_green_dark"
                android:textSize="18sp"
                android:gravity="center"
                tools:text="Total Amount :" />
            <!-- Buyer Name -->
            <TextView
                android:id="@+id/totalamt"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text=""
                android:layout_gravity="center"
                android:textColor="@android:color/holo_green_dark"
                android:textSize="18sp"
                tools:text=" Jon " />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>